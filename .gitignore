videos/
*.mp4
*.avi
*.mov

# IDE & System Files
.DS_Store
.vscode/
.idea/
*.log

# tracking artefacts
checkpoints/
*.pkl
*.npy
*.rrd

# Python environment (uv) and third-party code fetched by scripts/setup.sh
.venv/
third_party/

# local LeRobot datasets built by packages/data/log.py
datasets/


# robot env (packages/deploy): pixi environment (pixi.lock is committed) and editable-install metadata
.pixi/
*.egg-info/
spike_realsense.png

# raw recordings (Aria .vrs is ignored above; D435 demos are folders of images)
raw_data/
